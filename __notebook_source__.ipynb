def ajouter_features(df):
    """Ma feature : age et age_mois disent la même chose, donc quand ils se contredisent, la saisie est douteuse."""
    df = df.copy()
    df["age_incoherent"] = ((df["age_mois"] / 12 - df["age"]).abs() > 1).astype(int)
    return df

