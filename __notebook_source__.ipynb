        continue
    p1, p0 = sub.loc[sub.avec, "absent"].mean(), sub.loc[~sub.avec, "absent"].mean()
    barre = 100 * (p1 * (1 - p1) / n1 + p0 * (1 - p0) / n0) ** 0.5      # barre de bruit de l'ECART
    ecart = 100 * (p1 - p0)
    tranches.append({"tranche": str(t), "lignes": min(n1, n0), "lignes_avec": n1, "lignes_sans": n0,
