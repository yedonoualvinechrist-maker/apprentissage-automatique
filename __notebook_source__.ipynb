def mesure_base(seed=0):
    a, b, c, d = train_test_split(Xn_base, y, test_size=0.2, stratify=y, random_state=seed)
    return HistGradientBoostingClassifier(random_state=0).fit(a, c).score(b, d)
 
def mesure_donnee(seed=0):
    Xd = Xn_base.drop(columns=["zone_clinique"], errors="ignore")
    a, b, c, d = train_test_split(Xd, y, test_size=0.2, stratify=y, random_state=seed)
    return HistGradientBoostingClassifier(random_state=0).fit(a, c).score(b, d)
 
def mesure_reglage(seed=0):
    a, b, c, d = train_test_split(Xn_base, y, test_size=0.2, stratify=y, random_state=seed)
    m = HistGradientBoostingClassifier(max_iter=300, learning_rate=0.05, random_state=0)
    return m.fit(a, c).score(b, d)
 
def mesure_famille(seed=0):
    Xf = pd.get_dummies(Xn_base, columns=CAT).fillna(0)
    a, b, c, d = train_test_split(Xf, y, test_size=0.2, stratify=y, random_state=seed)
    m = RandomForestClassifier(n_estimators=100, min_samples_leaf=5, n_jobs=-1, random_state=0)
    return m.fit(a, c).score(b, d)
 
