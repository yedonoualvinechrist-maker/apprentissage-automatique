def chercher_sentinelles(df, cible=CIBLE, identifiant=ID):
    codes = {-1, -9, -99, -999, -9999, 999, 9999, 99999}
    p_glob = df[cible].mean()
    res = []
    for col in df.columns:
        if col in (cible, identifiant):
            continue
        s = df[col]
        if s.dtype == object:                                  
            conv = pd.to_numeric(s, errors="coerce")
            if conv.notna().sum() == 0 or conv.notna().sum() < 0.9 * s.notna().sum():
                continue
            s = conv
        if not pd.api.types.is_numeric_dtype(s):
            continue
        sn = s.dropna()
        if len(sn) == 0 or sn.nunique() > 0.5 * len(sn):        
            continue
        mediane = sn.median()
        iqr = sn.quantile(0.75) - sn.quantile(0.25)
        rare_neg = (sn < 0).mean() < 0.01
        cand = {v for v in codes if v in set(sn.unique())} | {sn.min(), sn.max()}
        if rare_neg:
            cand |= set(sn[sn < 0].unique())
        for v in cand:
            n = int((s == v).sum())
            if not (0 < n < 5000):
                continue
            if v in codes:
                raison = "code usuel de valeur manquante"
            elif v < 0 and rare_neg:
                raison = "valeur négative dans une colonne positive"
            elif iqr > 0 and abs(v - mediane) > 6 * iqr:
                raison = "valeur extrême et répétée"
            else:
                continue
            taux = 100 * df.loc[s == v, cible].mean()
            z = (taux - 100 * p_glob) / (100 * (p_glob * (1 - p_glob) / n) ** 0.5)
            res.append({"colonne": col, "valeur": v, "lignes": n, "taux_absence": round(taux, 1),
                        "ecart_en_barres": round(z, 1), "raison": raison})
    return pd.DataFrame(res)
 
