delai_complet = pd.to_numeric(train[col_delai], errors="coerce") if col_delai in train.columns else \
    (pd.to_datetime(train["date_rdv"]) - pd.to_datetime(train["date_prise"])).dt.days
seuil = float(delai_complet.quantile(0.75))
print(f"seuil du délai très long (75e centile de train) : {seuil:.0f}")
hypothese("delai_tres_long",
          f"les rendez-vous pris {seuil:.0f} jours ou plus à l'avance font plus d'absents (signe +)",
          "ajouter la colonne (délai >= seuil) puis mesurer le score sur la même validation, en barres de bruit",
          "le score ne gagne pas plus de 2 barres de bruit (2 x erreur_type) quand on ajoute la colonne")
hypothese("rappel_efficace_si_delai_long",
          "le rappel réduit les absences surtout quand le délai est long (signe - sur l'écart avec/sans rappel)",
          "comparer l'écart de taux avec/sans rappel dans les tranches longues et dans les courtes, avec leur barre",
          "l'écart avec/sans rappel n'est pas plus négatif dans les tranches longues que dans les courtes, "
          "de plus de 2 barres")
hypothese("age_65_plus",
          "les patients de 65 ans et plus manquent moins de rendez-vous (signe -)",
          "comparer le taux d'absence de age >= 65 et de age < 65, avec la barre de bruit de l'écart",
          "l'écart entre les deux taux d'absence fait moins de 2 barres de bruit")
prevoir("delai_tres_long", "gain nul ou très faible (0) : un arbre trouve déjà le seuil seul",
        "un arbre coupe lui-même le délai là où il faut : une colonne seuil n'ajoute pas d'information")
 
def mesure_delai_tres_long():
    Xf = X_sans_features.assign(delai_tres_long=(delai_complet >= seuil).astype(int))
    a, b, c, d_ = train_test_split(Xf, y, test_size=0.2, stratify=y, random_state=0)
    return HistGradientBoostingClassifier(random_state=0).fit(a, c).score(b, d_)
 
s_h = essai("delai_tres_long", mesure_delai_tres_long, "ajout de la colonne delai_tres_long")
gain_h = (s_h - score_interne) / erreur_type
confirmee_ou_contredite = "confirmée" if gain_h >= 2 else "contredite"    
print(f"gain : {gain_h:+.2f} barre(s) -> {confirmee_ou_contredite}")
 
if confirmee_ou_contredite == "contredite":
    suite_donnee = (
        f"Contredite : le gain est de {gain_h:+.2f} barre(s), sous le critère de deux barres que j'avais annoncé. "
        "Ça m'apprend qu'un arbre trouve déjà le seuil du délai tout seul, donc je n'ajoute pas cette colonne : "
        "je garde le délai brut et je passe à l'hypothèse sur le rappel, que je teste par tranches.")
else:
    suite_donnee = (
        f"Confirmée : le gain est de {gain_h:+.2f} barre(s), au-dessus du critère de deux barres annoncé. "
        "Comme c'est le résultat d'un essai choisi, je le revérifie sur un second découpage avant de garder la "
        "colonne, pour ne pas prendre un coup de chance pour un vrai gain.")
