def suspects(df, cible, identifiant=ID, min_effectif=50):
    """Une ligne par colonne suspecte : colonne, ecart_remplissage (points), signe, detail.
       Signe 'vide'  : remplie d'un côté, vide de l'autre (écart de remplissage de plus de 50 points).
       Signe 'valeur': remplie des deux côtés, mais une valeur (portée par au moins min_effectif lignes)
                       ne vit que dans UN groupe de la cible.
       L'identifiant et la cible sont ignorés : la cible ne sert qu'à séparer les deux groupes."""
    groupes = df[cible]
    g0, g1 = (groupes == 0), (groupes == 1)
    lignes = []
    for col in df.columns:
        if col in (cible, identifiant):
            continue
        serie = df[col]
        if serie.dtype == object:
            serie = serie.replace("", np.nan)
        r0, r1 = 100 * serie[g0].notna().mean(), 100 * serie[g1].notna().mean()
        ecart = abs(r1 - r0)
        if ecart > 50:                                                        # signe 1 : le VIDE
            lignes.append({"colonne": col, "ecart_remplissage": round(ecart, 1), "signe": "vide",
                           "detail": f"remplie à {r0:.0f} % chez les présents, {r1:.0f} % chez les absents"})
            continue
        if r0 == 0 or r1 == 0 or serie.nunique() > 255:                       # signe 2 : la VALEUR
            continue
        tab = pd.crosstab(serie, groupes).reindex(columns=[0, 1], fill_value=0)
        seul1 = tab[(tab[0] == 0) & (tab[1] >= min_effectif)]
        seul0 = tab[(tab[1] == 0) & (tab[0] >= min_effectif)]
        if len(seul1) or len(seul0):
            if len(seul1):
                v, n, qui = seul1[1].idxmax(), int(seul1[1].max()), "absents"
            else:
                v, n, qui = seul0[0].idxmax(), int(seul0[0].max()), "présents"
            lignes.append({"colonne": col, "ecart_remplissage": round(ecart, 1), "signe": "valeur",
                           "detail": f"la valeur « {v} » ({n} lignes) ne vit que chez les {qui}"})
    return pd.DataFrame(lignes, columns=["colonne", "ecart_remplissage", "signe", "detail"])
 
