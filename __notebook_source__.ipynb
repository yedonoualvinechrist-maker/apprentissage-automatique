print(f"taux d'absence avec rappel : {100 * d.loc[d.avec, 'absent'].mean():.1f} % | "
      f"sans : {100 * d.loc[~d.avec, 'absent'].mean():.1f} % | écart global : {ecart_global:+.1f} points")
bornes = [0, 2, 7, 14, 30, 60, np.inf]
d["tranche"] = pd.cut(d["delai"], bins=bornes, right=False)
tranches, tranches_exclues = [], []
for t in d["tranche"].cat.categories:
    sub = d[d["tranche"] == t]
    n1, n0 = int(sub["avec"].sum()), int((~sub["avec"]).sum())
    if n1 == 0 or n0 == 0:
        tranches_exclues.append(f"{t} : ne porte qu'un seul groupe ({n1} avec rappel, {n0} sans) : "
                                "pas de comparaison possible")
